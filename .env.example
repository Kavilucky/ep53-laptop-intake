# Скопируйте в .env и заполните. Файл .env не публикуйте и храните копию отдельно от сервера.
# Сгенерировать значения: openssl rand -hex 32
POSTGRES_USER=laptopintake
POSTGRES_PASSWORD=СМЕНИТЕ_НА_СЛУЧАЙНОЕ
POSTGRES_DB=laptopintake
N8N_ENCRYPTION_KEY=СМЕНИТЕ_НА_СЛУЧАЙНОЕ_И_НЕ_МЕНЯЙТЕ
HOST=intake.example-shop.ru
TZ=Europe/Moscow
TUNNEL_TOKEN=ВСТАВЬТЕ_ТОКЕН_ТУННЕЛЯ_CLOUDFLARE
# Токен бота создаётся у BotFather и вносится в учётные данные Telegram в n8n (не в .env)
ADMIN_CHAT_ID=0
# Токен приёмки: его вводит скрипт на флешке в заголовок X-Radar-Token. Не короче 16 символов, openssl rand -hex 32
INTAKE_TOKEN=СМЕНИТЕ_НА_СЛУЧАЙНОЕ_НЕ_КОРОЧЕ_16_СИМВОЛОВ
# Модель для Ollama (пример, не проверялась): подберите по железу и проверьте качество ответа в формате JSON
OLLAMA_MODEL=qwen2.5:3b
